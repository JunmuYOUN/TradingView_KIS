# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 한국투자증권 KIS Developers 에서 발급받은 키. 비워 두면 MOCK(가짜 시세)로 실행됩니다.
# 여기에 적은 키는 평문으로 남습니다. Windows 에서는 비워 두고 데스크톱 앱(계정 -> 한투 API 로그인)에서
# 연결하세요. 키가 암호화되어 저장되고, 여기가 비어 있으면 run.bat 도 그 키를 씁니다.
KIS_APP_KEY=
KIS_APP_SECRET=

# 환경 변수로 키를 지정할 때는 키 종류에 맞춰 real 또는 demo를 입력합니다. 데스크톱 로그인은 자동으로 확인합니다.
KIS_ENV=demo

# 국내 시세 기본값은 J(KRX)입니다. 설정 탭에서 선택한 거래소가 우선합니다. UN은 통합, NX는 NXT입니다.
KIS_MARKET=J

# auto: 키가 있으면 kis, 없으면 mock / kis / mock
DATA_SOURCE=auto

# 초당 REST 호출 수 (기본: 실전 15, 모의 4)
# KIS_RATE_PER_SEC=4

# 종목명 검색용 종목 마스터를 한국투자증권 공개 서버에서 받을지 (auto / off)
# off 이면 주요 종목과 검색 기록에 있는 종목만 이름으로 찾을 수 있습니다 (코드로는 언제든 열 수 있음)
SYMBOL_DOWNLOAD=auto

HOST=127.0.0.1
PORT=8000

# 브라우저로 외부 주소에서 접속할 때 사용할 인증서와 키의 경로입니다.
# WEB_TLS_CERT=
# WEB_TLS_KEY=
# WEB_PUBLIC_HOST=chart.example.com
