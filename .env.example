# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 한국투자증권 KIS Developers 에서 발급받은 키. 비워 두면 MOCK(가짜 시세)로 실행됩니다.
# 여기에 적은 키는 평문으로 남습니다. Windows 에서는 비워 두고 데스크톱 앱(설정 -> 한투 API 연결)에서
# 연결하세요. 키가 암호화되어 저장되고, 여기가 비어 있으면 run.bat 도 그 키를 씁니다.
KIS_APP_KEY=
KIS_APP_SECRET=

# real: 실전투자 키 / demo: 모의투자 키 (키 종류와 반드시 일치해야 합니다)
KIS_ENV=demo

# J: KRX, UN: KRX+NXT 통합, NX: NXT
# 실시간 체결 TR 도 자동으로 맞춰집니다 (J->H0STCNT0, UN->H0UNCNT0, NX->H0NXCNT0)
KIS_MARKET=J

# auto: 키가 있으면 kis, 없으면 mock / kis / mock
DATA_SOURCE=auto

# 초당 REST 호출 수 (기본: 실전 15, 모의 4)
# KIS_RATE_PER_SEC=4

# 종목명 검색용 종목 마스터를 한국투자증권 공개 서버에서 받을지 (auto / off)
# off 이면 주요 종목과 검색 기록에 있는 종목만 이름으로 찾을 수 있습니다 (코드로는 언제든 열 수 있음)
SYMBOL_DOWNLOAD=auto

HOST=127.0.0.1
PORT=8000
