<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="chart_background">#131722</color>
    <color name="chart_surface">#1E222D</color>
    <color name="chart_text">#D1D4DC</color>
    <color name="chart_text_muted">#9598A1</color>
    <color name="chart_accent">#5B8CFF</color>
    <color name="chart_error">#FF6B6B</color>
    <color name="icon_background">#02041A</color>

    <!-- 데스크톱 화면과 같은 어두운 색입니다. 시스템이 밝은 테마여도 바뀌지 않습니다. -->
    <style name="Theme.KisTradingView" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/chart_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/chart_surface</item>
        <item name="colorSurfaceContainerHigh">@color/chart_surface</item>
        <item name="colorOnSurface">@color/chart_text</item>
        <item name="colorOnSurfaceVariant">@color/chart_text_muted</item>
        <item name="colorError">@color/chart_error</item>
        <item name="android:colorBackground">@color/chart_background</item>
        <item name="android:windowBackground">@color/chart_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
